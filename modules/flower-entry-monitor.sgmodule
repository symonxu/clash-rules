#!name=花云入口监控与告警
#!desc=定时及切网时通过本机外部控制器实测花云各地区代表节点真实延迟，并查询公网入口解析，在面板展示结果；发现超时自动发系统通知告警。
#!arguments=巡检间隔:*/30 * * * *,控制密钥:
#!arguments-desc=巡检间隔为 Cron 表达式（默认每 30 分钟）；控制密钥填「更多 › 客户端设置 › 外部控制器（本机 127.0.0.1:9090）」中的密钥，仅保存在本地设置中。

[Script]
花云入口定时巡检 = type=cron, cronexp="{{{巡检间隔}}}", timeout=15, script-path=https://raw.githubusercontent.com/symonxu/clash-rules/main/modules/flower-entry-monitor.js, argument="mode=cron&secret={{{控制密钥}}}"
花云入口切网巡检 = type=event, event-name=network-changed, timeout=15, script-path=https://raw.githubusercontent.com/symonxu/clash-rules/main/modules/flower-entry-monitor.js, argument="mode=network&secret={{{控制密钥}}}"
花云入口监控面板 = type=generic, timeout=15, script-path=https://raw.githubusercontent.com/symonxu/clash-rules/main/modules/flower-entry-monitor.js, argument="mode=panel&secret={{{控制密钥}}}"

[Panel]
花云入口监控面板 = title=花云入口状态, content=请在模块设置填入控制密钥后点右侧刷新, script-name=花云入口监控面板, update-interval=1800
