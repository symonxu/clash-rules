# 延迟测试 URL 由主配置 provider 的 benchmark-url 统一指定；组内 interval/lazy 控制测试调度。
# 节点由 XM-Stash.yaml 的 proxy-provider: MESL-Nodes 提供；这里只定义个人策略组。
proxy-groups: #!replace
  - name: 🌐 日常上网
    type: select
    proxies:
      - ⚡ 自动选快
      - 🧭 全部节点

  - name: ⚡ 自动选快
    type: url-test
    use:
      - MESL-Nodes
    filter: '^(🇸🇬 新加坡 0[1-3]|🇯🇵 日本 0[1-3])'
    interval: 600
    lazy: true

  - name: 🧭 全部节点
    type: select
    use:
      - MESL-Nodes
    # 只关闭该组的定时测速；同一节点仍可被其他常用组测速。
    interval: -1

  - name: 🔎 Google服务
    type: fallback
    use:
      - MESL-Nodes
    filter: '^🇯🇵 日本 0[1-3]'
    interval: 300
    lazy: false

  - name: 🤖 AI工具
    type: fallback
    use:
      - MESL-Nodes
    filter: '^🇯🇵 日本 (08|09|10) 家宽'
    interval: 300
    lazy: false

  - name: 🇯🇵 Web3-日本家宽
    # 按订阅顺序选择可用节点；故障或恢复时仍可能切换，不保证固定 IP。
    type: fallback
    use:
      - MESL-Nodes
    filter: '^🇯🇵 日本 (08|09|10) 家宽'
    interval: 300
    lazy: false

  - name: 🇯🇵 Web3-日本普通
    type: url-test
    use:
      - MESL-Nodes
    filter: '^🇯🇵 日本 0[1-3]'
    interval: 300
    lazy: false

  - name: 💰 Web3交易
    type: fallback
    proxies:
      - 🇯🇵 Web3-日本家宽
      - 🇯🇵 Web3-日本普通
    interval: 300
    lazy: false

  - name: ⛓️ Web3链上数据
    type: url-test
    use:
      - MESL-Nodes
    filter: '^(🇯🇵 日本 (08|09|10) 家宽|🇯🇵 日本 0[1-3])'
    interval: 300
    lazy: false

rule-providers: #!replace
  中国大陆域名:
    type: http
    behavior: domain
    format: yaml
    url: https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    path: ./rule-providers/china-direct-domain.yaml
    interval: 86400

  中国大陆IP:
    type: http
    behavior: ipcidr
    format: yaml
    url: https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt
    path: ./rule-providers/china-direct-ip.yaml
    interval: 86400

# 完全替换主配置 rules；MESL 节点仍由 XM-Stash.yaml 的 MESL-Nodes provider 自动更新。
rules: #!replace
  # 局域网
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  # Web3 链上数据 / RPC（必须在 Web3 钱包与平台规则前）
