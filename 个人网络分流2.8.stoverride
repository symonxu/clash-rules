name: 个人网络分流2.8
category: 个人网络分流
desc: >-
  以 MESL 为节点来源，但完全替换其策略组和分流规则。
  MESL 更新节点参数后继续自动生效；日常自动优选不使用香港节点。
  Google、AI、Web3、Apple 和中国大陆流量按个人策略分流；普通 Web3 交易与链上数据优先日本/新加坡家宽自动选快，Polymarket 独立使用当前官方非受限国家的家宽节点自动选快，并单独分流 MetaMask Predict 后端。

# 固定自己的基础网络设置；MESL 后续修改这些字段不会覆盖个人设置。
mode: rule
ipv6: false

dns: #!replace
  enable: true
  listen: 0.0.0.0:1053
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  use-hosts: true
  default-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  - 114.114.114.114
  nameserver:
  - https://dns.alidns.com/dns-query
  - https://doh.pub/dns-query
  fake-ip-filter:
  - '*.lan'
  - '*.linksys.com'
  - '*.linksyssmartwifi.com'
  - +.apps.apple.com
  - +.itunes.apple.com
  - +.mzstatic.com
  - ppq.apple.com
  - api.apple-cloudkit.com
  - appldnld.apple.com.edgesuite.net
  - configuration.apple.com
  - oscdn.apple.com
  - osrecovery.apple.com
  - skl.apple.com
  - updates-http.cdn-apple.com
  - updates.cdn-apple.com
  - xp.apple.com
  - gdmf-ados.apple.com
  - gsra.apple.com
  - wkms-public.apple.com
  - fcs-keys-pub-prod.cdn-apple.com
  - appldnld.apple.com
  - gdmf.apple.com
  - gg.apple.com
  - gs.apple.com
  - ig.apple.com
  - mesu.apple.com
  - swscan.apple.com
  - swquery.apple.com
  - swdownload.apple.com
  - swcdn.apple.com
  - swdist.apple.com
  - '*.msftconnecttest.com'
  - '*.msftncsi.com'
  - xbox.*.microsoft.com
  - xbox.*.*.microsoft.com
  - +.xboxlive.com
  - time.*.com
  - time.*.gov
  - time.*.edu.cn
  - time.*.apple.com
  - time1.*.com
  - time2.*.com
  - time3.*.com
  - time4.*.com
  - time5.*.com
  - time6.*.com
  - time7.*.com
  - ntp.*.com
  - ntp.*.com
  - ntp1.*.com
  - ntp2.*.com
  - ntp3.*.com
  - ntp4.*.com
  - ntp5.*.com
  - ntp6.*.com
  - ntp7.*.com
  - '*.time.edu.cn'
  - '*.ntp.org.cn'
  - +.pool.ntp.org
  - time1.cloud.tencent.com
  - lens.l.google.com
  - +.music.163.com
  - +.126.net
  - musicapi.taihe.com
  - music.taihe.com
  - songsearch.kugou.com
  - trackercdn.kugou.com
  - '*.kuwo.cn'
  - api-jooxtt.sanook.com
  - api.joox.com
  - joox.com
  - +.y.qq.com
  - +.music.tc.qq.com
  - aqqmusic.tc.qq.com
  - +.stream.qqmusic.qq.com
  - +.xiami.com
  - +.music.migu.cn
  - +.stun.*.*
  - +.stun.*.*.*
  - +.stun.*.*.*.*
  - +.stun.*.*.*.*.*
  - +.srv.nintendo.net
  - '*.n.n.srv.nintendo.net'
  - +.stun.playstation.net
  - +.battlenet.com.cn
  - +.wotgame.cn
  - +.wggames.cn
  - +.wowsgame.cn
  - +.wargaming.net
  - '*.square-enix.com'
  - '*.finalfantasyxiv.com'
  - '*.ffxiv.com'
