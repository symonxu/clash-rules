# 保留 MESL 原始 proxies 节点列表，只替换策略组。
proxy-groups: #!replace
  - name: 🌐 日常上网
    type: select
    proxies:
      - ⚡ 自动选快
      - 🧭 全部节点

  - name: ⚡ 自动选快
    type: url-test
    include-all: true
    filter: '^(🇸🇬 新加坡 0[1-3]|🇯🇵 日本 0[1-3])'
    url: http://1.1.1.1/generate_204
    interval: 600
    lazy: true

  - name: 🧭 全部节点
    type: select
    include-all: true

  - name: 🔎 Google服务
    type: fallback
    include-all: true
    filter: '^🇯🇵 日本 0[1-3]'
    url: http://1.1.1.1/generate_204
    interval: 300
    lazy: false

  - name: 🤖 AI工具
    type: fallback
    include-all: true
    filter: '^🇯🇵 日本 (08|09|10) 家宽'
    url: http://1.1.1.1/generate_204
    interval: 300
    lazy: false

  - name: 💰 Web3交易
    type: url-test
    include-all: true
    filter: '(日本 (08|09|10) 家宽$|新加坡 .*家宽$)'
    url: http://1.1.1.1/generate_204
    interval: 180
    lazy: false

  - name: ⛓️ Web3链上数据
    type: url-test
    include-all: true
    filter: '(日本 (08|09|10) 家宽$|新加坡 .*家宽$)'
    url: http://1.1.1.1/generate_204
    interval: 180
    lazy: false

  - name: 🎯 Polymarket
    type: url-test
    include-all: true
    # 当前 Polymarket 官方非受限国家中的 MESL 常见家宽候选。
    # 明确排除 JP/SG/BR/VE/TH/TW/US 等官方受限地区，也不使用香港节点。
    filter: '(马来西亚|菲律宾|越南|印度尼西亚|韩国|印度|墨西哥|智利|阿根廷|秘鲁|哥伦比亚|厄瓜多尔|乌拉圭|巴拉圭|玻利维亚|西班牙|葡萄牙|瑞士|奥地利|瑞典|挪威|芬兰|丹麦).*家宽$'
    url: http://1.1.1.1/generate_204
    interval: 180
    lazy: false

rule-providers: #!replace
  中国大陆域名:
    type: http
    behavior: domain
    format: yaml
    url: https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/direct.txt
    path: ./rule-providers/china-direct-domain.yaml
    interval: 86400

  中国大陆IP:
    type: http
    behavior: ipcidr
    format: yaml
    url: https://fastly.jsdelivr.net/gh/Loyalsoldier/clash-rules@release/cncidr.txt
    path: ./rule-providers/china-direct-ip.yaml
    interval: 86400

# 完全替换 MESL 原有 rules；节点本身仍由 MESL 订阅提供和更新。
rules: #!replace
  # 局域网
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve

  # Web3 链上数据 / RPC（必须在 Web3 钱包与平台规则前）
  - DOMAIN-SUFFIX,infura.io,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,alchemy.com,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,alchemyapi.io,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,llamarpc.com,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,ankr.com,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,1rpc.io,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,publicnode.com,⛓️ Web3链上数据
  - DOMAIN-SUFFIX,polygon-rpc.com,⛓️ Web3链上数据
