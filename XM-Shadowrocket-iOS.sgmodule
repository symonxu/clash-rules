#!name=XM iOS 个人分流
#!desc=旧版模块；个人规则现已合并进 XM-Shadowrocket-Groups.conf，请停用本模块。
# iOS / Shadowrocket 专用模块，不是节点订阅或完整配置。
# 必须配合 XM-Shadowrocket-Groups.conf 使用；模块不能作为分组已加载的证明。
# 全局路由选择 配置；订阅节点名须匹配下方筛选条件。
# 不设置周期测速；各组使用手动选择。

[Proxy Group]
XM-Google = select,policy-regex-filter=日本 (0[2-4](\s|$)|(08|09|10) 家宽(\s|$))
XM-AI = select,policy-regex-filter=日本 (0[2-4](\s|$)|(08|09|10) 家宽(\s|$))
XM-Meta = select,policy-regex-filter=美国 (0[1-3](\s|$)|1[0-2] 家宽(\s|$))
XM-Web3 = select,policy-regex-filter=日本 (0[2-4](\s|$)|(08|09|10) 家宽(\s|$))
XM-日常上网 = select,policy-regex-filter=日本 (0[2-4](\s|$)|(08|09|10) 家宽(\s|$))

[Rule]
# web3-rpc
DOMAIN-SUFFIX,infura.io,XM-Web3
DOMAIN-SUFFIX,alchemy.com,XM-Web3
DOMAIN-SUFFIX,alchemyapi.io,XM-Web3
DOMAIN-SUFFIX,llamarpc.com,XM-Web3
